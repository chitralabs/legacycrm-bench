# Meridian CRM 4.2 validation rules (synthetic legacy artifact; VRL semantics in SYSTEM_OVERVIEW.md §2)

# --- Accounts ---
RULE ACC-001 ON ACCT_MASTER WHEN INSERT,UPDATE : LEN(ACCT_NM) >= 2 ELSE ERROR E1001 "Account name too short"
RULE ACC-002 ON ACCT_MASTER WHEN INSERT,UPDATE : ACCT_TYP = 'C' OR ACCT_TYP = 'P' OR ACCT_TYP = 'R' OR ACCT_TYP = 'X' ELSE ERROR E1002 "Invalid account type"
RULE ACC-003 ON ACCT_MASTER WHEN INSERT,UPDATE : NVL(ANN_REV, 0) >= 0 ELSE ERROR E1003 "Annual revenue negative"
RULE ACC-004 ON ACCT_MASTER WHEN UPDATE : NOT (OLD.CRED_HOLD = 'Y' AND CRED_HOLD = 'N' AND CRED_LIMIT <= 0) ELSE ERROR E1004 "Cannot release credit hold with zero credit limit"
RULE ACC-005 ON ACCT_MASTER WHEN INSERT,UPDATE : LEN(REGION_CD) = 3 ELSE ERROR E1005 "Region code must be 3 chars" SEVERITY WARN

# --- Contacts ---
RULE CON-001 ON CONT_MASTER WHEN INSERT,UPDATE : LEN(LAST_NM) >= 1 ELSE ERROR E2001 "Last name required"
RULE CON-002 ON CONT_MASTER WHEN INSERT,UPDATE : EMAIL_TX = '' OR LEN(EMAIL_TX) >= 5 ELSE ERROR E2002 "Email too short"
RULE CON-003 ON CONT_MASTER WHEN INSERT : LOOKUP(ACCT_MASTER, ACCT_ID, ACCT_ID, ACCT_ID) <> '' ELSE ERROR E2003 "Contact must reference a live account"
RULE CON-004 ON CONT_MASTER WHEN INSERT,UPDATE : NOT (OPTOUT_FLG = 'Y' AND PREF_CH = 'E' AND EMAIL_TX = '') ELSE ERROR E2004 "Opted-out email preference without address" SEVERITY WARN

# --- Opportunities ---
RULE OPP-001 ON OPP_MASTER WHEN INSERT,UPDATE : NVL(AMT, 0) >= 0 ELSE ERROR E3001 "Amount negative"
RULE OPP-002 ON OPP_MASTER WHEN INSERT,UPDATE : NOT (STAT_CD = 'W' AND NVL(AMT,0) = 0) ELSE ERROR E3002 "Won opportunity requires amount"
RULE OPP-003 ON OPP_MASTER WHEN INSERT,UPDATE : NOT (STAT_CD = 'L' AND LOST_RSN = '') ELSE ERROR E3003 "Lost reason required"
RULE OPP-004 ON OPP_MASTER WHEN INSERT,UPDATE : NOT (STAT_CD = 'W' AND CLOSE_DT = '00000000') ELSE ERROR E3004 "Won opportunity requires close date"
RULE OPP-005 ON OPP_MASTER WHEN UPDATE : NOT (OLD.STAT_CD = 'W' AND STAT_CD <> 'W') ELSE ERROR E3005 "Cannot reopen a won opportunity"
RULE OPP-006 ON OPP_MASTER WHEN INSERT,UPDATE : (STAT_CD = 'P' AND STAGE_PCT = 10) OR (STAT_CD = 'Q' AND STAGE_PCT = 25) OR (STAT_CD = 'N' AND STAGE_PCT = 60) OR (STAT_CD = 'W' AND STAGE_PCT = 100) OR (STAT_CD = 'L' AND STAGE_PCT = 0) ELSE ERROR E3006 "Stage percent inconsistent with status"
RULE OPP-007 ON OPP_MASTER WHEN INSERT : CLOSE_DT = '00000000' OR CLOSE_DT >= TODAY() ELSE ERROR E3007 "Close date in past" SEVERITY WARN

# --- Cases ---
RULE CAS-001 ON CASE_MASTER WHEN INSERT,UPDATE : SEV_CD = '1' OR SEV_CD = '2' OR SEV_CD = '3' OR SEV_CD = '4' ELSE ERROR E4001 "Invalid severity"
RULE CAS-002 ON CASE_MASTER WHEN UPDATE : NOT (STAT_CD = 'R' AND RES_DT = '00000000') ELSE ERROR E4002 "Resolved case requires resolution date"
RULE CAS-003 ON CASE_MASTER WHEN UPDATE : NOT (OLD.STAT_CD = 'X' AND STAT_CD <> 'X') ELSE ERROR E4003 "Cannot modify closed case status"
RULE CAS-004 ON CASE_MASTER WHEN INSERT : LEN(SUBJ_TX) >= 5 ELSE ERROR E4004 "Subject too short"

# --- Orders ---
RULE ORD-001 ON ORD_HEADER WHEN INSERT,UPDATE : DISC_PCT >= 0 AND DISC_PCT <= 100 ELSE ERROR E5001 "Discount out of range"
RULE ORD-002 ON ORD_HEADER WHEN UPDATE : NOT (DISC_PCT > 20 AND LOOKUP(USR_MASTER, USR_ID, OWNER_UID, ROLE_ID) <> 'MGR' AND LOOKUP(USR_MASTER, USR_ID, OWNER_UID, ROLE_ID) <> 'ADMIN') ELSE ERROR E5002 "Discount over 20 percent requires manager role"
RULE ORD-003 ON ORD_HEADER WHEN UPDATE : NOT (OLD.STAT_CD = 'I' AND STAT_CD <> 'I' AND STAT_CD <> 'X') ELSE ERROR E5003 "Invoiced order can only be cancelled"
RULE ORD-004 ON ORD_LINE WHEN INSERT,UPDATE : QTY > 0 ELSE ERROR E5004 "Quantity must be positive"
RULE ORD-005 ON ORD_LINE WHEN INSERT : LOOKUP(PROD_MASTER, PROD_ID, PROD_ID, ACTIVE_FLG) = 'Y' ELSE ERROR E5005 "Product not active"
