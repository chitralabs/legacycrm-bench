# Excerpt of validation_rules.vrl (Meridian CRM 4.2, synthetic legacy artifact)
# --- Orders ---
RULE ORD-001 ON ORD_HEADER WHEN INSERT,UPDATE : DISC_PCT >= 0 AND DISC_PCT <= 100 ELSE ERROR E5001 "Discount out of range"
RULE ORD-002 ON ORD_HEADER WHEN UPDATE : NOT (DISC_PCT > 20 AND LOOKUP(USR_MASTER, USR_ID, OWNER_UID, ROLE_ID) <> 'MGR' AND LOOKUP(USR_MASTER, USR_ID, OWNER_UID, ROLE_ID) <> 'ADMIN') ELSE ERROR E5002 "Discount over 20 percent requires manager role"
RULE ORD-003 ON ORD_HEADER WHEN UPDATE : NOT (OLD.STAT_CD = 'I' AND STAT_CD <> 'I' AND STAT_CD <> 'X') ELSE ERROR E5003 "Invoiced order can only be cancelled"
RULE ORD-004 ON ORD_LINE WHEN INSERT,UPDATE : QTY > 0 ELSE ERROR E5004 "Quantity must be positive"
RULE ORD-005 ON ORD_LINE WHEN INSERT : LOOKUP(PROD_MASTER, PROD_ID, PROD_ID, ACTIVE_FLG) = 'Y' ELSE ERROR E5005 "Product not active"
